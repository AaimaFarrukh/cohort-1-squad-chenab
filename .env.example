# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────
# Get these from developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=               # Permanent access token
WHATSAPP_PHONE_NUMBER_ID=     # Your WhatsApp Business phone number ID
WHATSAPP_VERIFY_TOKEN=        # Any string you choose — must match Meta webhook config

# ── Gemini API (Google AI Studio) ─────────────────────────────────────────
# Get from aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash  # Don't change for MVP — Flash is cheapest

# ── Supabase ───────────────────────────────────────────────────────────────
# Get from supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # Use service role key, NOT anon key
SUPABASE_STORAGE_BUCKET=receipts

# ── Rate limiting ──────────────────────────────────────────────────────────
DAILY_RECEIPT_LIMIT=20         # Max receipt scans per user per day

# Phase 4: protects the /internal/run-digest endpoint
CRON_SECRET=your-long-random-secret-here
